{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Book.cpp",
                "${workspaceFolder}/src/BorrowedBook.cpp",
                "${workspaceFolder}/src/Genre.cpp",
                "${workspaceFolder}/src/Library.cpp",
                "${workspaceFolder}/src/DatabaseException.cpp",
                "${workspaceFolder}/src/Menu.cpp",
                "${workspaceFolder}/src/DatabaseStatistics.cpp",
                "-o",
                "${workspaceFolder}/Library.exe",
                "-L",
                "C:/msys64/mingw64/lib",
                "-I",
                "C:/msys64/mingw64/include",
                "-I",
                "${workspaceFolder}/include",
                "-lsqlite3"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}